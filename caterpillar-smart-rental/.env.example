# All names use the FLEETSIGNAL_ prefix. Demo controls are disabled by default.
# Leave database/data variables unset to use absolute project-local defaults:
#   <project>/.fleetsignal/fleetsignal.db and <project>/data
# Configured SQLite file URLs and data directories must be absolute.
# Windows example: sqlite:///D:/Projects/FleetSignal/caterpillar-smart-rental/.fleetsignal/fleetsignal.db
# Linux/container example: sqlite:////var/lib/fleetsignal/fleetsignal.db
# FLEETSIGNAL_DATABASE_URL=sqlite:////var/lib/fleetsignal/fleetsignal.db
# FLEETSIGNAL_DATA_DIR=/opt/fleetsignal/data
FLEETSIGNAL_DEMO_MODE=false
FLEETSIGNAL_SQLITE_BUSY_TIMEOUT_MS=5000
FLEETSIGNAL_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

# Existing demo clock (unchanged):
# SRTS_DEMO_DATE=2025-05-12
